---
interface Props {
  headline?: string;
  subtitle?: string;
  showButton?: boolean;
  buttonHref?: string;
  buttonText?: string;
  compact?: boolean;
}

const {
  headline = 'Come Fly With Us',
  subtitle,
  showButton = true,
  buttonHref = '/about',
  buttonText = 'Learn About the Club',
  compact = false,
} = Astro.props;
---

<section class:list={['hero', { 'hero--compact': compact }]}>
  <div class="hero-inner">
    <h1>{headline}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {
      showButton && (
        <a href={buttonHref} class="btn btn-outline">
          {buttonText}
        </a>
      )
    }
  </div>
</section>
