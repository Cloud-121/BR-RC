---
import type { ClubEvent } from '../lib/fetchGroupEvents';

interface Props {
  event: ClubEvent;
}

const { event } = Astro.props;
---

<article class="event-card">
  <h3>
    <a href={event.url} target="_blank" rel="noopener noreferrer">{event.title}</a>
  </h3>
  <p class="event-date">{event.startTime}</p>
  {event.location && <p>{event.location}</p>}
  {event.description && <p>{event.description}</p>}
  <a href={event.url} class="btn btn-small" target="_blank" rel="noopener noreferrer">View on Facebook</a>
</article>
